{
  // Mirrors packages/identity/tsconfig.json deliberately: same base, same composite layout, same
  // dist/.tsbuildinfo. `include` is `src/**/*.ts` and NOT `src/chain/**`, so the KYC track can add
  // src/kyc/** and src/status/** without touching this file (its write lock forbids that).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../identity" }]
}
