{
  "name": "@stellaronramp/gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Issuer-side library: KYC claim derivation, BBS+ credential issuance, the revocation status list, session tokens, and the reads the issuer makes against kyc-gate.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellaronramp/identity": "0.1.0",
    "@stellar/stellar-sdk": "16.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erhantrk/stellar-onramp.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://github.com/erhantrk/stellar-onramp#readme",
  "publishConfig": {
    "access": "public"
  }
}
