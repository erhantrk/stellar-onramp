{
  "name": "@stellaronramp/identity",
  "version": "0.1.0",
  "type": "module",
  "description": "BBS+ credentials for Stellar: issue, selectively disclose, verify, revoke via a Bitstring Status List.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures/vectors.json": "./fixtures/vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fixtures",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "vectors": "node --experimental-strip-types scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@digitalbazaar/bbs-signatures": "3.1.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erhantrk/stellar-onramp.git",
    "directory": "packages/identity"
  },
  "homepage": "https://github.com/erhantrk/stellar-onramp#readme",
  "publishConfig": {
    "access": "public"
  }
}
